# Copy to .env.local for local development only. Never commit real values.
SEARCH_ENDPOINT=https://<search-service>.<usnat-search-suffix>
SEARCH_INDEX_NAME=msdocs-content-v2
SEMANTIC_CONFIG_NAME=default-semantic-config
KNOWLEDGE_SOURCE_NAME=msdocs-content-v2-ks
KNOWLEDGE_BASE_NAME=msdocs-content-v2-kb
MCP_API_VERSION=<approved-mcp-api-version>
SEARCH_AUDIENCE=https://<usnat-search-token-audience>
SEARCH_TOKEN_SCOPE=https://<usnat-search-token-audience>/.default

AOAI_ENDPOINT=https://<ai-services-resource>.<usnat-ai-services-suffix>
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AOAI_CHAT_DEPLOYMENT=<approved-chat-deployment>
AOAI_API_VERSION=<approved-azure-openai-api-version>
COGNITIVE_SERVICES_TOKEN_SCOPE=https://<usnat-cognitive-token-audience>/.default

BLOB_ACCOUNT_URL=https://<storage-account>.blob.<usnat-storage-suffix>
BLOB_CONTAINER_NAME=crawled-pages
STORAGE_AUDIENCE=https://<usnat-storage-token-audience>

CONTENT_SOURCE_ORIGIN=https://<approved-learn-mirror-host>
SITEMAP_INDEX=https://<approved-learn-mirror-host>/_sitemaps/sitemapindex.xml
SITEMAP_NAME_FILTER=azure_en-us
ALLOWED_PREFIXES=https://<approved-learn-mirror-host>/en-us/azure/

ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<application-client-id>
ENTRA_CLIENT_SECRET=<store-locally-only>
ENTRA_AUTHORITY_HOST=https://<usnat-entra-authority>
FLASK_SECRET_KEY=<random-secret>
AZURE_AUTHORITY_HOST=https://<usnat-entra-authority>
