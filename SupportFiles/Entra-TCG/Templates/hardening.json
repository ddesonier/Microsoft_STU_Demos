          "grantControls": {
            "operator": "OR",
            "authenticationStrength": { "id": "00000000-0000-0000-0000-000000000002" }
          },
          "sessionControls": {
            "signInFrequency": {
              "isEnabled": true,
              "frequencyInterval": "everyTime",
              "authenticationType": "primaryAndSecondaryAuthentication"
