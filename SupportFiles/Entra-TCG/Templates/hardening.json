{
  "template": "hardening",
  "version": "1.0.0",
  "updated": "2026-09-14",
  "description": "Entra ID security hardening baseline: break-glass and external-users groups, default user-permission restrictions, PIM authentication context, and Conditional Access policies (report-only).",
  "graphScopes": {
    "delegated": [
      "Group.ReadWrite.All",
      "Policy.ReadWrite.Authorization",
      "Policy.ReadWrite.ConditionalAccess",
      "Policy.Read.All",
      "AuthenticationContext.ReadWrite.All",
      "Application.Read.All",
      "GroupSettings.ReadWrite.All"
    ],
    "application": [
      "Group.ReadWrite.All",
      "Policy.ReadWrite.Authorization",
      "Policy.ReadWrite.ConditionalAccess",
      "Policy.Read.All",
      "AuthenticationContext.ReadWrite.All",
      "Application.Read.All",
      "Directory.ReadWrite.All"
    ]
  },
  "resources": [
    {
      "name": "Group - Emergency Access (break glass)",
      "type": "group",
      "captureAs": "emergencyAccess",
      "mode": "create",
      "exists": {
        "method": "GET",
        "uri": "{{graph-endpoint}}/v1.0/groups?$filter=displayName eq 'Emergency Access'",
        "match": "value[0]"
      },
      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/groups",
        "body": {
          "displayName": "Emergency Access",
          "description": "TCG - Break-glass emergency access accounts. ACTION REQUIRED: populate with 2+ cloud-only emergency accounts. This group is EXCLUDED from all Conditional Access policies - keep membership minimal and monitored.",
          "mailEnabled": false,
          "mailNickname": "emergencyAccess",
          "securityEnabled": true,
          "groupTypes": []
        }
      }
    },
    {
      "name": "Group - External Users All (dynamic)",
      "type": "group",
      "captureAs": "externalUsersAll",
      "mode": "create",
      "exists": {
        "method": "GET",
        "uri": "{{graph-endpoint}}/v1.0/groups?$filter=displayName eq 'External Users All'",
        "match": "value[0]"
      },
      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/groups",
        "body": {
          "displayName": "External Users All",
          "description": "TCG - All external users",
          "mailEnabled": false,
          "mailNickname": "ExternalUsersAll",
          "securityEnabled": true,
          "groupTypes": ["DynamicMembership"],
          "membershipRule": "(user.userPrincipalName -contains \"#EXT#\")",
          "membershipRuleProcessingState": "On"
        }
      }
    },
    {
      "name": "Authorization policy - default user permissions hardening",
      "type": "authorizationPolicy",
      "mode": "configure",
      "configure": {
        "method": "PATCH",
        "uri": "{{graph-endpoint}}/v1.0/policies/authorizationPolicy",
        "body": {
          "guestUserRoleId": "10dae51f-b6af-4016-8d66-8c2a99b929b3",
          "defaultUserRolePermissions": {
            "allowedToCreateApps": false,
            "allowedToCreateSecurityGroups": false,
            "allowedToCreateTenants": false,
            "permissionGrantPoliciesAssigned": []
          }
        }
      }
    },
    {
      "name": "Group settings - disable group and Team owner app consent",
      "type": "groupSetting",
      "mode": "create",
      "exists": {
        "method": "GET",
        "uri": "{{graph-endpoint}}/v1.0/groupSettings",
        "match": "value[?templateId=='62375ab9-6b52-47ed-826b-58e47e0e304b']|[0]"
      },
      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/groupSettings",
        "body": {
          "templateId": "62375ab9-6b52-47ed-826b-58e47e0e304b",
          "values": [
            { "name": "EnableGroupSpecificConsent", "value": "false" }
          ]
        }
      }
    },
    {
      "name": "Authentication context - PIM Admin Context",
      "type": "authenticationContextClassReference",
      "mode": "configure",
      "configure": {
        "method": "PATCH",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/authenticationContextClassReferences/c90",
        "body": {
          "id": "c90",
          "displayName": "PIM Admin Context",
          "description": "Authentication context used for PIM privileged role activation",
          "isAvailable": true
        }
      }
    },
    {
      "name": "TCG01: Require MFA for all users",
      "type": "conditionalAccessPolicy",
      "mode": "create",
      "dependsOn": ["Group - Emergency Access (break glass)"],
      "exists": {
        "method": "GET",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/policies",
        "match": "value[?displayName=='TCG01: Require MFA for all users']|[0]"
      },
      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/policies",
        "body": {
          "displayName": "TCG01: Require MFA for all users",
          "state": "enabledForReportingButNotEnforced",
          "conditions": {
            "clientAppTypes": ["all"],
            "applications": { "includeApplications": ["All"] },
            "users": {
              "includeUsers": ["All"],
              "excludeGroups": ["{{emergencyAccess.id}}"]
            }
          },
          "grantControls": {
            "operator": "OR",
            "authenticationStrength": { "id": "00000000-0000-0000-0000-000000000002" }
          }
        }
      }
    },
    {
      "name": "TCG02: Require Hybrid Entra Join",
      "type": "conditionalAccessPolicy",
      "mode": "create",
      "dependsOn": ["Group - Emergency Access (break glass)"],
      "exists": {
        "method": "GET",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/policies",
        "match": "value[?displayName=='TCG02: Require Hybrid Entra Join']|[0]"
      },
      "create": {
        "method": "POST",
        "uri": "{{graph-endpoint}}/v1.0/identity/conditionalAccess/policies",
        "body": {
          "displayName": "TCG02: Require Hybrid Entra Join",
          "state": "enabledForReportingButNotEnforced",
          "conditions": {
            "clientAppTypes": ["all"],
            "applications": { "includeApplications": ["All"] },
            "users": {
              "includeUsers": ["All"],
              "excludeGroups": ["{{emergencyAccess.id}}"]
            }
          },
          "grantControls": {
            "operator": "OR",
            "builtInControls": ["domainJoinedDevice"]
          }
        }
      }
    },
    {
